# Local, offline API setup. The root .env.example targets Docker Compose.
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=sqlite:///./matriva.db
REDIS_URL=
VECTOR_DATABASE_URL=
AUTO_CREATE_TABLES=false
RAG_ENGINE=local
RAG_ORCHESTRATOR=langchain
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-unique-random-value-at-least-32-characters

# Local mode never needs providers. Blank values override a root .env file.
LLM_API_KEY=
EMBEDDING_API_KEY=
TAVILY_API_KEY=
