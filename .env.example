# Runtime
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://matriva:change-me@db:5432/matriva
REDIS_URL=redis://redis:6379/0
VECTOR_DATABASE_URL=postgresql+psycopg://matriva:change-me@db:5432/matriva
AUTO_CREATE_TABLES=false
RAG_ENGINE=local
RAG_ORCHESTRATOR=langchain
DEMO_MODE=true

# Browser/API
CORS_ORIGINS=http://localhost:3000

# Auth: generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-unique-random-value-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30

# Limits
MAX_UPLOAD_BYTES=10000000
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_GENERAL_PER_MINUTE=120

# Which engine answers: "local" (default) is the offline pipeline and needs no key or network.
# "external" uses Groq and Gemini and needs the keys below.
RAG_ENGINE=local

# Longest chat message the API accepts (100 to 20000)
MAX_MESSAGE_CHARS=4000

# Optional providers (only used when RAG_ENGINE=external; leave blank otherwise)
INSTALL_OPTIONAL=false
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=models/gemini-embedding-001

# Tavily web search (https://tavily.com) -- supplementary evidence source used ONLY
# when the local knowledge base has insufficient evidence for a query. Leave blank to
# keep today's exact "insufficient evidence" behavior with no external calls.
TAVILY_API_KEY=

# LangSmith tracing -- OFF by default, and read docs/observability.md before enabling.
#
# MATRIVA handles pregnancy and health questions. Tracing uploads the run tree to
# LangSmith's SaaS, which by default includes the user's literal question, the
# retrieved source passages and the generated answer. That is personal health
# information leaving the system.
#
# Use for development and demos with synthetic data only. Producing traces in a
# real deployment needs a data-processing agreement, a self-hosted LangSmith, or
# a redaction layer first -- not just this flag.
#
# When enabled, LANGSMITH_ANONYMIZE=true (the default) keeps the run tree --
# stage names, durations, token counts, citation ids, pass/fail -- while keeping
# the verbatim question and answer on the machine.
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=matriva
LANGSMITH_API_KEY=
LANGSMITH_ANONYMIZE=true
